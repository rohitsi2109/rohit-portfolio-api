# Neon pooled connection string (host contains "-pooler"). Used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/portfolio?sslmode=require
# Neon direct (non-pooled) connection string. Used by Alembic migrations only.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/portfolio?sslmode=require

CAL_USERNAME=rohit-singh-g2fz4h
CAL_EVENT_SLUG=15min
# Optional: public event types can be booked without a key
CAL_API_KEY=
# Set the same value in Cal.com -> Settings -> Developer -> Webhooks
CAL_WEBHOOK_SECRET=

# 64 random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

CORS_ORIGINS=https://rohitsingh.in,https://www.rohitsingh.in,http://localhost:5179

# Bump when the privacy policy text on the website changes
CONSENT_VERSION=privacy-2026-11

# Firebase Cloud Messaging: the service account key JSON on one line
# (Firebase console -> Project settings -> Service accounts -> Generate new private key).
# Push is skipped while this is empty.
FIREBASE_SERVICE_ACCOUNT=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /v1/cron/daily-brief; set any long random value
CRON_SECRET=
